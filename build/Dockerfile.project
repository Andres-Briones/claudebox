# Project-specific Dockerfile that builds on top of a shared base.
# BASE_IMAGE defaults to claudebox-core; if the project has any heavy
# profiles (latex, wolfram, ...), it's a shared claudebox-<heavies>-base
# tag built once and reused across all projects with the same heavy set.
FROM {{BASE_IMAGE}}

# Switch to root for installations
USER root

{{PROFILE_INSTALLATIONS}}

{{LABELS}}

# Switch back to the claude user
USER claude
WORKDIR /workspace

# Re-pin Claude Code to the version recorded by `claudebox update`.
# The base image bakes in whatever version was latest when it was built,
# so without this any rebuild would silently revert a `claudebox update`.
# Empty pin (never updated) keeps the base image's version untouched.
ARG CLAUDE_CODE_VERSION=""
RUN bash -c 'if [ -n "$CLAUDE_CODE_VERSION" ]; then \
        source "$NVM_DIR/nvm.sh" && nvm use default && \
        npm install -g "@anthropic-ai/claude-code@$CLAUDE_CODE_VERSION"; \
    fi'

# Copy entrypoint (in case it needs updating)
USER root
COPY --chown=claude docker-entrypoint.sh /usr/local/bin/docker-entrypoint
RUN sed -i 's|DOCKERUSER|claude|g' /usr/local/bin/docker-entrypoint && \
    chmod +x /usr/local/bin/docker-entrypoint

# Set the entrypoint
ENTRYPOINT ["/usr/local/bin/docker-entrypoint"]